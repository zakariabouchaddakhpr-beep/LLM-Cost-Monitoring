# Copy to .env and fill in real values. Never commit .env — it is git-ignored.
#
# Every project that uses this library keeps its own .env. The library reads the
# .env of whichever project it was imported into (searching upward from the
# working directory), which is what gives each project its own separate traces.

# =============================================================================
# Trace database (required — the library has no default)
# =============================================================================
# Each project names its own ClickHouse database. Two projects must never share
# one: that separation is what keeps their traces apart.
#
# Letters, digits and underscores only. A hyphen is not legal in a ClickHouse
# identifier without backtick quoting, and neither is a leading digit.

CLICKHOUSE_DATABASE=my_project

# Leave these as localhost. docker-compose overrides both for the containers
# (where the server is reachable as 'clickhouse' on the container's own 8123),
# so the same .env works for `docker compose up` and for running the library
# directly on your machine. 8123 is the HTTP interface — not the native
# protocol on 9000, which is a different wire format.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123

# BOTH are required, and the password must not be blank. With neither set, the
# ClickHouse image disables network access for the user and every connection
# fails with "Authentication failed".
CLICKHOUSE_USER=llmobs
CLICKHOUSE_PASSWORD=change-me

# =============================================================================
# Project identity (optional)
# =============================================================================
# Shown in the dashboard title, and used by docker-compose for container names.
PROJECT_NAME=my-project

# Host ports published by docker-compose. Change these when running several
# projects at once so they don't collide.
# DASHBOARD_PORT=8501

# =============================================================================
# LLM provider API keys (at least one required)
# =============================================================================
# LiteLLM picks the right key automatically from the model-string prefix, so you
# only need keys for the providers you actually call. Quality scoring uses a Groq
# judge model, so it needs GROQ_API_KEY even if your main calls go elsewhere.

OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=gsk-your-groq-key
CEREBRAS_API_KEY=csk-your-cerebras-key

# =============================================================================
# OpenTelemetry (optional)
# =============================================================================
# With an endpoint set, spans and metrics go to that OTLP collector; without one
# they print to the console. From Docker, a collector on the host is reachable at
# host.docker.internal:4317, not localhost.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=my-project

# =============================================================================
# Not configured here
# =============================================================================
# tenant_id and use_case are per-call arguments, not environment variables:
#   monitor.call(prompt, tenant_id="acme-corp", use_case="support-chat")
