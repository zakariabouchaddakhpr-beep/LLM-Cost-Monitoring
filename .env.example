# Example environment variables — copy this file to .env and fill in your real API keys.

# =============================================================================
# LLM Provider API Keys (at least one required)
# =============================================================================
# LiteLLM reads these automatically based on the model string prefix.
# You only need the key for the provider(s) you actually call.

OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=gsk-your-groq-key
CEREBRAS_API_KEY=your-cerebras-key

# =============================================================================
# OpenTelemetry (optional)
# =============================================================================
# If set, traces and metrics are exported to this OTLP endpoint.
# If omitted, they print to console (useful for local debugging).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# OTEL_SERVICE_NAME=llm-monitor

# =============================================================================
# DuckDB Persistence (optional)
# =============================================================================
# Where the DuckDB file lives. Default is results/llm_traces.duckdb
# DUCKDB_PATH=/app/results/llm_traces.duckdb
